{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three-things-reviews",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "reviews.threethingsplanner.com", "custom_domain": true }],
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/doc", "/ui"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "three-things-reviews", "database_id": "59cf86e1-bf63-407c-bd6d-621a90b31f47", "migrations_dir": "migrations" }
  ],
  // Cloudflare Email Sending; the binding may only send as reviews@.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["reviews@threethingsplanner.com"] }
  ],
  // Weekly reviews summary: Mondays 13:00 UTC (9am Eastern).
  "triggers": { "crons": ["0 13 * * 1"] },
  "vars": {
    "EMAIL_FROM": "reviews@threethingsplanner.com",
    "ADMIN_URL": "https://reviews.threethingsplanner.com",
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://reviews.threethingsplanner.com/api/auth",
    "AUTH_TRUSTED_ORIGINS": "https://reviews.threethingsplanner.com",
    "CORS_ALLOWED_ORIGINS": "https://reviews.threethingsplanner.com"
  }
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, SUBMIT_SECRET
}
