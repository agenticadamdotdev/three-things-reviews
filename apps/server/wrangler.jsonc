{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "three-things-reviews",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "reviews.threethingsplanner.com", "custom_domain": true }],
  "assets": {
    "directory": "../admin/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/doc", "/ui"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "three-things-reviews", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations" }
  ],
  "vars": {
    "NODE_ENV": "production",
    "BETTER_AUTH_URL": "https://reviews.threethingsplanner.com/api/auth",
    "AUTH_TRUSTED_ORIGINS": "https://reviews.threethingsplanner.com",
    "CORS_ALLOWED_ORIGINS": "https://reviews.threethingsplanner.com"
  }
  // Secrets (wrangler secret put): BETTER_AUTH_SECRET, SUBMIT_SECRET
}
